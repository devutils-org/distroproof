{
  "$defs": {
    "Entry": {
      "description": "One piece of information in the report.",
      "oneOf": [
        {
          "description": "Value obtained.",
          "properties": {
            "status": {
              "const": "ok",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "Information missing or impossible to obtain (missing file, nonexistent syscall…); holds the reason.",
          "properties": {
            "status": {
              "const": "unavailable",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "Access denied (EPERM, EACCES, seccomp…); holds the errno and the context.",
          "properties": {
            "status": {
              "const": "denied",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "value"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "privileged": {
          "description": "The result depends on the process's privileges (root, capabilities).",
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "privileged"
      ],
      "type": "object"
    },
    "Section": {
      "description": "A report category, for example \"kernel\" or \"bpf\".",
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/Entry"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "entries"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Full report, as written by `envprobe --json`.",
  "properties": {
    "envprobe_version": {
      "type": "string"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/Section"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "envprobe_version",
    "sections"
  ],
  "title": "Report",
  "type": "object"
}
